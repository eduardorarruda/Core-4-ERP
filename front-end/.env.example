# URL base da API backend.
# - Docker/produção (nginx faz proxy de /api): deixe VAZIA → chamadas same-origin (/api/...).
#   A CSP do nginx (connect-src 'self') assume isso; uma origem externa aqui exige ajustar a CSP.
# - Dev local com `npm run dev`: o Vite faz proxy de /api para VITE_API_PROXY_TARGET.
VITE_API_URL=
# Alvo do proxy do Vite em desenvolvimento (vite.config.js)
VITE_API_PROXY_TARGET=http://localhost:8080
