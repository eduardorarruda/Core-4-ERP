# ─────────────────────────────────────────────────────────────────────────────
# Backend Core 4 rodando FORA do Docker (./gradlew bootRun) — copie para core4erp/.env.
# O EnvConfig carrega este arquivo antes do Spring subir. SOMENTE placeholders.
# Para a stack completa (docker compose), use o .env.example da RAIZ do repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────────────────────
# Em ambiente Docker, use: jdbc:postgresql://db:5432/core4erp
DB_URL=jdbc:postgresql://localhost:5432/core4erp
DB_USERNAME=postgres
DB_PASSWORD=troque-por-senha-local
POSTGRES_DB=core4erp
# Tamanho máximo do pool HikariCP
DB_POOL_SIZE=8
# Estatísticas do Hibernate (detectar N+1 em dev/staging)
HIBERNATE_STATS_ENABLED=false

# ── Servidor / perfil ─────────────────────────────────────────────────────────
PORT=8080
# Actuator (health/prometheus) em porta de gestão separada — nunca publicar em produção
MANAGEMENT_PORT=8081
# Perfil: vazio = dev; prod = Flyway estrito, logs JSON, health sem detalhes
SPRING_PROFILES_ACTIVE=
# Formato de log: texto (legível) | json (ECS, para Loki). O perfil prod força json.
LOG_FORMAT=texto
# true SOMENTE atrás de proxy confiável (nginx/cloudflared): IP do cliente vem de
# CF-Connecting-IP → X-Real-IP. Em dev local deixe false.
TRUSTED_PROXY=false
# Ambiente (development | staging | production) — aparece nas métricas Prometheus
APP_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
# HS256 — gere com: openssl rand -base64 64
SECRET_KEY=gere-com-openssl-rand-base64-64
# Expiração em milissegundos (604800000 = 7 dias)
TOKEN_EXPIRATION=604800000
# OPCIONAL — Ed25519 (PEM). Definidas as duas, o JWT é assinado com a chave privada.
#   openssl genpkey -algorithm ed25519 -out jwt-priv.pem
#   openssl pkey -in jwt-priv.pem -pubout -out jwt-pub.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Criptografia de CPF/CNPJ em repouso (OBRIGATÓRIAS) ───────────────────────
# 32 bytes base64 cada, chaves DIFERENTES: openssl rand -base64 32
# Perder a DATA_ENCRYPTION_KEY = dados cifrados ilegíveis.
DATA_ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
DATA_HMAC_KEY=gere-com-openssl-rand-base64-32
# Cifra na subida os valores legados em texto puro (idempotente). false = pular.
CRYPTO_MIGRAR_NA_SUBIDA=true

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# URL do frontend — também usada como base do link de reset de senha
CORS_ORIGINS=http://localhost:5173

# ── AI Chat — OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-substitua
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensão do embedding (cria a coleção do Qdrant sem chamar a OpenAI). Mude junto com o modelo.
OPENAI_EMBEDDING_DIMENSIONS=1536
# Preço USD por 1M tokens (só para a métrica de custo)
CHAT_PRECO_INPUT=0.15
CHAT_PRECO_OUTPUT=0.60

# ── RAG — Qdrant ──────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=core4erp_rag
QDRANT_API_KEY=gere-com-openssl-rand-hex-32
RAG_TOP_K=4
RAG_SIMILARIDADE_MINIMA=0.4
RAG_QDRANT_REST_URL=http://localhost:6333

# ── n8n ───────────────────────────────────────────────────────────────────────
# Vazio = integração desligada (processamento em processo)
N8N_WEBHOOK_URL=
N8N_EVENTOS_WEBHOOK_URL=
N8N_AUREA_WEBHOOK_URL=http://localhost:5678/webhook/aurea
# Header X-Webhook-Secret enviado ao n8n (obrigatório quando o n8n estiver ligado)
N8N_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32
N8N_READ_TIMEOUT_SECONDS=60
# interno | shadow (só admin) | n8n (todos)
CHAT_ORQUESTRADOR=interno

# ── E-mail — reset de senha ───────────────────────────────────────────────────
# MAIL_ENABLED=true  → envia por SMTP (MAIL_*) e o /actuator/health passa a checar o SMTP.
# MAIL_ENABLED=false → NADA é enviado e o health ignora o SMTP. Fora do perfil prod o link de
#   redefinição/convite é registrado no log (INFO) para demonstração; em prod (compose) não —
#   sem e-mail, recuperar senha/convidar só funciona com o envio ligado.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-usuario@exemplo.com
# Gmail: use uma "Senha de app" (App Password), não a senha normal
MAIL_PASSWORD=senha-de-app
MAIL_FROM=noreply@seu-dominio.exemplo

# ── Traces → Painel EBPÓS (OpenTelemetry — só com o -javaagent) ───────────────
NMON_INGEST_KEY=
NMON_OTLP_ENDPOINT=https://monitoramento.exemplo
OTEL_SERVICE_NAME=core4erp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
OTEL_SDK_DISABLED=true
