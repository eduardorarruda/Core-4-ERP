# ─────────────────────────────────────────────────────────────────────────────
# Core 4 ERP — variáveis do docker-compose.yml (copie para .env e preencha).
# SOMENTE placeholders: nunca commite valores reais. O .env real fica só no servidor.
# Marcadas [OBRIGATÓRIA] = o `docker compose` recusa subir sem elas.
# Ver DEPLOY.md › "Variáveis de ambiente" e › "Rotação de segredos".
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco (Postgres do compose) ──────────────────────────────────────────────
DB_URL=jdbc:postgresql://db:5432/core4erp
# [OBRIGATÓRIAS] usuário/senha do ERP (senha: openssl rand -base64 32)
DB_USERNAME=core4erp
DB_PASSWORD=troque-por-senha-forte
POSTGRES_DB=core4erp
# Pool HikariCP (perfil prod usa 10 por padrão)
DB_POOL_SIZE=10

# ── Perfil / ambiente do backend ─────────────────────────────────────────────
# O compose já fixa SPRING_PROFILES_ACTIVE=prod, LOG_FORMAT=json e TRUSTED_PROXY=true no
# serviço backend; listadas aqui só para referência (rodar o backend fora do compose).
# SPRING_PROFILES_ACTIVE=prod
# LOG_FORMAT=json
# TRUSTED_PROXY=true
APP_ENV=production

# ── JWT ──────────────────────────────────────────────────────────────────────
# [OBRIGATÓRIA] HS256 — gere com: openssl rand -base64 64
SECRET_KEY=gere-com-openssl-rand-base64-64
# Validade do token em ms (604800000 = 7 dias)
TOKEN_EXPIRATION=604800000
# OPCIONAL — JWT assimétrico (Ed25519). Com as duas definidas, o token é assinado com a privada.
#   openssl genpkey -algorithm ed25519 -out jwt-priv.pem
#   openssl pkey -in jwt-priv.pem -pubout -out jwt-pub.pem
# PEM multilinha no .env: use aspas duplas e \n literais (ver DEPLOY.md › "JWT Ed25519").
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Criptografia de dados pessoais (CPF/CNPJ em repouso) ─────────────────────
# [OBRIGATÓRIA] AES-256 — openssl rand -base64 32
# PERDER esta chave = CPF/CNPJ criptografados ficam ILEGÍVEIS. Guarde FORA do servidor.
DATA_ENCRYPTION_KEY=gere-com-openssl-rand-base64-32
# [OBRIGATÓRIA] índice cego (HMAC) para busca/unicidade — openssl rand -base64 32
DATA_HMAC_KEY=gere-com-openssl-rand-base64-32
# Cifra na subida os valores legados em texto puro (idempotente). false = pular.
CRYPTO_MIGRAR_NA_SUBIDA=true

# ── CORS / URL pública do front ──────────────────────────────────────────────
# Lista separada por vírgula. O 1º valor também é usado no link do e-mail de reset de senha.
CORS_ORIGINS=https://app.seu-dominio.exemplo

# ── IA — OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-substitua
OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensão do embedding (cria a coleção do Qdrant sem chamar a OpenAI). Mude junto com o modelo.
# OPENAI_EMBEDDING_DIMENSIONS=1536
# CHAT_PRECO_INPUT=0.15
# CHAT_PRECO_OUTPUT=0.60

# ── RAG — Qdrant ─────────────────────────────────────────────────────────────
# [OBRIGATÓRIA] API key do Qdrant (backend, n8n e scripts/backup.sh usam) — openssl rand -hex 32
QDRANT_API_KEY=gere-com-openssl-rand-hex-32
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_COLLECTION=core4erp_rag
# RAG_TOP_K=4
# RAG_SIMILARIDADE_MINIMA=0.4
# RAG_QDRANT_REST_URL=http://qdrant:6333

# ── n8n ──────────────────────────────────────────────────────────────────────
# [OBRIGATÓRIA] segredo do header X-Webhook-Secret (backend → n8n) — openssl rand -hex 32
N8N_WEBHOOK_SECRET=gere-com-openssl-rand-hex-32
# [OBRIGATÓRIA] criptografa as credenciais salvas no n8n — openssl rand -hex 32
# Guarde FORA do servidor (sem ela, o backup do n8n não abre as credenciais).
N8N_ENCRYPTION_KEY=gere-com-openssl-rand-hex-32
# [OBRIGATÓRIAS] role Postgres DEDICADO do n8n (≠ DB_USERNAME; não acessa o banco do ERP)
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=troque-por-senha-forte
N8N_DB_TYPE=postgresdb
N8N_DB_NAME=n8n
# N8N_DB_HOST=db
# Editor do n8n: acesso SOMENTE por túnel SSH (http://localhost:5678). Não publique o editor.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678/
N8N_SECURE_COOKIE=true
N8N_PROXY_HOPS=0
# Orquestrador do chat: interno | shadow (só admin) | n8n (todos)
CHAT_ORQUESTRADOR=interno
N8N_READ_TIMEOUT_SECONDS=95
# URLs internas (defaults do compose já apontam para http://n8n:5678/webhook/...)
# N8N_WEBHOOK_URL=http://n8n:5678/webhook/rag-ingest
# N8N_EVENTOS_WEBHOOK_URL=http://n8n:5678/webhook/evento
# N8N_AUREA_WEBHOOK_URL=http://n8n:5678/webhook/aurea

# ── E-mail (reset de senha) ──────────────────────────────────────────────────
# MAIL_ENABLED=true  → envia por SMTP (MAIL_*) e o /actuator/health passa a checar o SMTP.
# MAIL_ENABLED=false → NADA é enviado e o health ignora o SMTP. Fora do perfil prod o link de
#   redefinição/convite é registrado no log (INFO) para demonstração; em prod (compose) não —
#   sem e-mail, recuperar senha/convidar só funciona com o envio ligado.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-usuario@exemplo.com
# Gmail: use uma "Senha de app", não a senha normal
MAIL_PASSWORD=senha-de-app
MAIL_FROM=noreply@seu-dominio.exemplo

# ── Observabilidade ──────────────────────────────────────────────────────────
# [OBRIGATÓRIA] senha do admin do Grafana (acesso via túnel SSH → http://localhost:3001)
GRAFANA_PASSWORD=troque-por-senha-forte
GRAFANA_URL=http://localhost:3001

# Alertmanager — destinos dos alertas do Prometheus (configure ao menos um em produção).
# E-mail: SMTP herda MAIL_* se ALERT_SMTP_* não forem definidos.
ALERT_EMAIL_TO=ops@seu-dominio.exemplo
ALERT_SMTP_SMARTHOST=smtp.gmail.com:587
ALERT_SMTP_FROM=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# Webhook (POST JSON do Alertmanager): ntfy, ponte p/ Slack/Discord/Telegram, n8n...
ALERT_WEBHOOK_URL=

# Traces → Painel EBPÓS (OpenTelemetry). Sem NMON_INGEST_KEY, use OTEL_SDK_DISABLED=true.
NMON_OTLP_ENDPOINT=https://monitoramento.exemplo
NMON_INGEST_KEY=
OTEL_INGEST_HEADER=X-Painel-Key
OTEL_SERVICE_NAME=core4erp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
OTEL_SDK_DISABLED=true

# ── Cloudflare Tunnel (único túnel: container `cloudflared`) ─────────────────
# [OBRIGATÓRIA] token do túnel (painel Cloudflare Zero Trust → Tunnels)
TUNNEL_TOKEN=cole-o-token-do-tunel

# ── Backup (scripts/backup.sh — lidas do ambiente do cron, não pelo compose) ──
# BACKUP_DIR=/var/backups/core4erp
# BACKUP_RETENTION_DAYS=14
# RCLONE_REMOTE=remoto:core4erp-backups
