      },
      "id": "b1a11111-1111-4111-8111-111111111111",
      "name": "Webhook Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [160, 320],
      "webhookId": "rag-ingest-webhook",
      "credentials": {
