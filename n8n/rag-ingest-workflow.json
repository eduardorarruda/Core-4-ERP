{
  "name": "WF-DOC — RAG Ingest (pré-processamento de anexos)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-ingest",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "b1a11111-1111-4111-8111-111111111111",
      "name": "Webhook Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        320
      ],
      "webhookId": "rag-ingest-webhook",
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_HEADER_AUTH",
          "name": "N8N Webhook Secret (X-Webhook-Secret)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pré-processamento do anexo (Contrato 2 — n8n/CONTRATOS.md). NÃO indexa: o backend é o ÚNICO\n// gravador do Qdrant (layout Spring AI: 'doc_content' + 'empresaId' no topo do payload, o mesmo\n// lido pelo backend e pelo baseConhecimento do WF-ANALISTA). Aqui só normaliza e valida o tenant.\nconst b = ($input.first().json.body) || $input.first().json || {};\n\nconst empresaId = Number(b.empresaId);\nif (!Number.isInteger(empresaId) || empresaId <= 0) {\n  return [{ json: { valido: false, erro: 'empresaId obrigatório' } }];\n}\n\nlet texto = (b.texto || '').toString();\ntexto = texto\n  .replace(/\\r\\n/g, '\\n')\n  .split('\\n').map(function (l) { return l.replace(/[\\t ]+$/, ''); }).join('\\n')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nif (!texto) {\n  return [{ json: { valido: false, erro: 'texto vazio' } }];\n}\n\nreturn [{ json: { valido: true, texto: texto, tipo: b.tipo || 'anexo', fonte: b.fonte || '', empresaId: empresaId } }];"
      },
      "id": "c2a22222-2222-4222-8222-222222222222",
      "name": "Normalizar e Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
