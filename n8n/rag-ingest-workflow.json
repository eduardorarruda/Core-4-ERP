              { "name": "tipo", "value": "={{ $('Normalizar e Validar').item.json.tipo }}" },
              { "name": "fonte", "value": "={{ $('Normalizar e Validar').item.json.fonte }}" }
            ]
          }
        }
      },
      "id": "a6a66666-6666-4666-8666-666666666666",
      "name": "Data Loader (metadado empresaId)",
