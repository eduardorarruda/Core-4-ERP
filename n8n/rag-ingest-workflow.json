    {
      "parameters": {
        "jsCode": "// Normaliza o payload e VALIDA empresaId (obrigatório na Fase 2.1 — isolamento multi-tenant).\nconst b = ($input.first().json.body) || $input.first().json || {};\n\nconst empresaId = b.empresaId;\nif (empresaId === undefined || empresaId === null || empresaId === '') {\n  throw new Error('empresaId obrigatório — recusando ingest sem tenant (vazamento cross-tenant).');\n}\n\nlet texto = (b.texto || '').toString();\ntexto = texto\n  .replace(/\\r\\n/g, '\\n')\n  .split('\\n').map(function (l) { return l.replace(/[\\t ]+$/, ''); }).join('\\n')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nif (!texto) {\n  throw new Error('texto vazio — nada para indexar.');\n}\n\nreturn [{ json: { texto: texto, tipo: b.tipo || 'anexo', fonte: b.fonte || '', empresaId: empresaId } }];"
      },
      "id": "c2a22222-2222-4222-8222-222222222222",
      "name": "Normalizar e Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 320]
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "mode": "list",
          "value": "core4erp_rag",
          "cachedResultName": "core4erp_rag"
        },
        "options": {}
      },
      "id": "e4a44444-4444-4444-8444-444444444444",
      "name": "Qdrant Insert (core4erp_rag)",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.1,
      "position": [660, 320],
      "credentials": {
        "qdrantApi": {
          "id": "PLACEHOLDER_QDRANT",
          "name": "Qdrant Core4 (http://qdrant:6333)"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "f5a55555-5555-4555-8555-555555555555",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [560, 560],
      "credentials": {
