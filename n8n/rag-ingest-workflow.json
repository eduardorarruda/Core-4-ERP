        "chunkSize": 1000,
        "chunkOverlap": 100,
        "options": {}
      },
      "id": "b7a77777-7777-4777-8777-777777777777",
      "name": "Text Splitter (1000)",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [960, 760]
    },
    {
      "parameters": {
        "jsCode": "// O nó de insert do vector store devolve os documentos inseridos. Conta os chunks.\nconst n = $input.all().length;\nreturn [{ json: { ok: true, chunks: n } }];"
      },
      "id": "c8a88888-8888-4888-8888-888888888888",
      "name": "Contar Chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"chunks\": $json.chunks } }}",
        "options": {}
      },
      "id": "d9a99999-9999-4999-8999-999999999999",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 320]
    }
  ],
